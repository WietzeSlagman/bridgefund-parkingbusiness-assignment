{
  "name": "parkingbusiness-garage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:demo-load-api": "node --env-file=.env.load --import tsx src/tools/load-api.ts",
    "start:demo": "node --env-file=.env.load --import tsx src/tools/run.ts demo",
    "start:demo:visual": "node --env-file=.env.load --import tsx src/tools/run.ts visual",
    "start:load-test": "node --env-file=.env.load --import tsx src/tools/run.ts load",
    "db:migrate:load": "node --env-file=.env.load --import tsx src/tools/migrate-load.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --no-file-parallelism",
    "openapi:generate": "tsx src/openapi/generate.ts",
    "openapi:check": "tsx src/openapi/generate.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:update-buildings": "tsx src/update-buildings.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "pg": "^8.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.13",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.10",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.0.18"
  }
}
