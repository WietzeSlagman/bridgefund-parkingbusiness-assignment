# PUBLIC THROWAWAY credentials: isolated local use only, never deploy or reuse.
# Compose and the application both read this file. Shell exports take precedence.
DEV_DB_PASSWORD=local_dev_only
TEST_DB_PASSWORD=local_test_only
DATABASE_URL=postgresql://garage_dev:local_dev_only@localhost:55432/garage_dev
TEST_DATABASE_URL=postgresql://garage_test:local_test_only@localhost:55433/garage_test
PORT=3000
WEBHOOK_SECRET=local_webhook_only
# Resident-admin allowlist and limits; the pilot code and limit 50 are required.
PARKING_BUILDINGS={"PB-AMS-2M8D":50}
# JSON arrays allow rotation. These public keys provide no real security.
PARKING_KEYS={"entrance-1":["local_entrance_1"],"entrance-2":["local_entrance_2"],"exit-1":["local_exit_1"],"exit-2":["local_exit_2"],"admin":["local_admin"]}
